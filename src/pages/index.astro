---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { featured } from '../data/projects';
import { url } from '../lib/url';
import heroSrc from '../assets/cr26i-campus.jpg';

// Served as WebP at two widths rather than the 473 kB original, since this is
// the first thing a recruiter loads and often on a phone.
const heroWide = await getImage({ src: heroSrc, format: 'webp', width: 1800, quality: 72 });
const heroNarrow = await getImage({ src: heroSrc, format: 'webp', width: 900, quality: 70 });
---

<Base
  title={site.name}
  description="Engineering portfolio. Cooling Senior Engineer and Systems Engineering Lead on Crimson Racing, the University of Alabama Formula SAE team."
  path="/"
>
  <section class="hero" style={`background-image:url('${heroWide.src}')`}>
    <div class="wrap">
      <h1>{site.name}</h1>
      <p class="degree">{site.degree}</p>
      <p class="roles">
        <strong>{site.roles[0]}</strong> and <strong>{site.roles[1]}</strong>, {site.team}, {site.teamNote}
      </p>
      <div class="actions">
        {
          site.resumeUrl ? (
            <a class="btn btn-primary" href={url('/' + site.resumeUrl)}>
              Resume (PDF)
            </a>
          ) : (
            <span class="note-inline">Resume available on request.</span>
          )
        }
        <a class="btn btn-quiet" href={`mailto:${site.email}`}>{site.email}</a>
        {
          site.linkedin && (
            <a class="btn btn-quiet" href={site.linkedin}>
              LinkedIn
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Featured work</h2>
      <ul class="cards">
        {featured.map((project) => <ProjectCard project={project} />)}
      </ul>
      <p style="margin-top:1.5rem">
        <a href={url('/projects')}>All eight projects</a>
      </p>
    </div>
  </section>
</Base>

<style define:vars={{ heroNarrow: `url('${heroNarrow.src}')` }}>
  /* Phones get the 900px crop. Saves roughly two thirds of the bytes on the
     one image a recruiter opening a link from email will actually wait for. */
  @media (max-width: 48rem) {
    .hero {
      background-image: var(--heroNarrow) !important;
    }
  }
</style>
